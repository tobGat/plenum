    {
      "id": "s-tricks",
      "section": "S-umfragen",
      "type": "info",
      "title": "Mit Zahlen und Diagrammen beeinflussen",
      "cards": [
        {
          "title": "Zahlen wirken objektiv",
          "text": "Zahlen gelten als sachlich und überprüfbar. Trotzdem kann man mit ihnen die Meinung lenken."
        },
        {
          "title": "Trick 1: Ausschnitt wählen",
          "text": "Welche Jahre zeige ich? Wo beginnt die y-Achse? So wirken Unterschiede größer oder kleiner."
        },
        {
          "title": "Trick 2: Lücken verstecken",
          "text": "Fehlen Jahre auf der x-Achse, wirkt eine Entwicklung steiler oder flacher, als sie ist."
        },
        {
          "title": "Trick 3: Farben",
          "text": "Rot wirkt alarmierend, Grün beruhigend – bei denselben Zahlen."
        }
      ],
      "graphic": {
        "src": "lib:achtung",
        "pos": "corner",
        "size": "m"
      }
    },
